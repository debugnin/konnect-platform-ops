# Copy to terraform.tfvars (gitignored) and fill in real values.
# terraform.tfvars is auto-loaded by `terraform plan`/`apply` — no -var flags needed.

# Required — no default, specific to your Konnect org and target region.
cloud_gateway_region              = "" # e.g. "ap-southeast-2"
cloud_gateway_availability_zones  = [] # e.g. ["apse2-az1", "apse2-az2", "apse2-az3"]
cloud_gateway_kong_version        = "" # e.g. "3.11"

# Optional — override the defaults below if needed.
# cloud_gateway_provider = "aws"
# cloud_gateway_cidr_block = "10.0.0.0/16"
# control_plane_geo = "au"
# cloud_gateway_base_rps = 10

# cloud_gateway_provider_account_id is auto-discovered via the
# konnect_cloud_gateway_provider_account_list data source (filtered to
# cloud_gateway_provider) — no manual account-linking step needed. Only set
# it explicitly (see variables.tf) if your org has more than one provider
# account for the same cloud provider and you need to disambiguate.
